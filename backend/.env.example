# Copia este archivo como ".env" (en la misma carpeta backend/) y pega tu key real.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Tu Private API Key del workspace capstone-mia en Roboflow.
# La encuentras en: https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=pega_aqui_tu_api_key

# Puerto del backend (opcional, por defecto 3001)
PORT=3001

# Carpeta donde se guardan los .txt (opcional, por defecto backend/data/analisis)
# DATA_DIR=/ruta/a/disco/persistente
